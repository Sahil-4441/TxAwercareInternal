<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ScrollView
                android:id="@+id/scroll_main"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_16sdp"
                android:layout_marginVertical="@dimen/_16sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/tv_dont_have_account">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="@dimen/_4sdp"
                    app:cardBackgroundColor="@color/darkGreyColor">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_14sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/img_logo"
                        android:layout_width="@dimen/_70sdp"
                        android:src="@drawable/ic_logo"
                        android:layout_height="@dimen/_70sdp"
                        android:layout_marginTop="@dimen/_16sdp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_main_heading"
                        style="@style/TvFontSemibold"
                        android:textSize="@dimen/_16ssp"
                        android:layout_marginTop="@dimen/_20sdp"
                        app:layout_constraintTop_toBottomOf="@+id/img_logo"
                        app:layout_constraintStart_toStartOf="@id/img_logo"
                        app:layout_constraintEnd_toEndOf="@id/img_logo"
                        android:text="@string/welcome_back"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_sub_heading"
                        style="@style/customTextView"
                        android:layout_marginHorizontal="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        app:layout_constraintTop_toBottomOf="@+id/tv_main_heading"
                        app:layout_constraintStart_toStartOf="@id/tv_main_heading"
                        app:layout_constraintEnd_toEndOf="@id/tv_main_heading"
                        android:text="@string/signing_to_your_account"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_email"
                        style="@style/TvFontSemibold"
                        android:textColor="@color/secondaryTextColor"
                        android:layout_marginTop="@dimen/_20sdp"
                        app:layout_constraintTop_toBottomOf="@+id/tv_sub_heading"
                        app:layout_constraintStart_toStartOf="parent"
                        android:text="@string/email"/>

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_email"
                        style="@style/customEt"
                        android:hint="@string/email"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:inputType="textEmailAddress"
                        app:layout_constraintTop_toBottomOf="@+id/tv_email"
                        app:layout_constraintStart_toStartOf="@id/tv_email"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_password"
                        style="@style/TvFontSemibold"
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@color/secondaryTextColor"
                        android:layout_marginTop="@dimen/_12sdp"
                        app:layout_constraintTop_toBottomOf="@+id/et_email"
                        app:layout_constraintStart_toStartOf="@id/et_email"
                        android:text="@string/password"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/password_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconMode="password_toggle"
                        android:text="@string/password"
                        app:boxBackgroundMode="none"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleDrawable="@drawable/password_selector"
                        android:layout_marginTop="@dimen/_5sdp"
                        app:hintTextColor="@color/primaryEtTextColor"
                        app:helperTextTextColor="@color/primaryEtTextColor"
                        app:layout_constraintTop_toBottomOf="@+id/tv_password"
                        app:layout_constraintStart_toStartOf="@id/tv_password"
                        app:layout_constraintEnd_toEndOf="@id/et_email">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_password"
                            style="@style/customTextInputEt"
                            android:hint="@string/password"
                            android:textSize="@dimen/_11ssp"
                            android:fontFamily="@font/inter_medium"
                            android:inputType="textPassword"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_forgot_password"
                        style="@style/customTextView"
                        android:textColor="@color/secondaryTextColor"
                        android:layout_marginTop="@dimen/_5sdp"
                        app:layout_constraintTop_toBottomOf="@+id/password_layout"
                        app:layout_constraintEnd_toEndOf="@id/et_email"
                        android:text="@string/forgot_password"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_btn_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_14sdp"
                        android:background="@drawable/common_btn_bg"
                        app:layout_constraintEnd_toEndOf="@+id/password_layout"
                        app:layout_constraintStart_toStartOf="@+id/password_layout"
                        app:layout_constraintTop_toBottomOf="@+id/tv_forgot_password">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/btn_submit"
                            style="@style/customButtonWithArrow"
                            android:text="@string/log_in"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:id="@+id/view_sep_before"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/borderColor"
                        app:layout_constraintEnd_toStartOf="@+id/tv_or"
                        app:layout_constraintStart_toStartOf="@id/cl_btn_layout"
                        android:layout_marginTop="@dimen/_24sdp"
                        app:layout_constraintTop_toBottomOf="@+id/cl_btn_layout"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_or"
                        style="@style/customTextView"
                        android:textSize="@dimen/_9sdp"
                        android:paddingHorizontal="@dimen/_15sdp"
                        app:layout_constraintEnd_toStartOf="@+id/view_sep_after"
                        app:layout_constraintStart_toEndOf="@+id/view_sep_before"
                        app:layout_constraintTop_toTopOf="@id/view_sep_before"
                        app:layout_constraintBottom_toBottomOf="@+id/view_sep_before"
                        android:text="@string/or"/>

                    <View
                        android:id="@+id/view_sep_after"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/borderColor"
                        app:layout_constraintStart_toEndOf="@+id/tv_or"
                        app:layout_constraintEnd_toEndOf="@id/cl_btn_layout"
                        android:layout_marginTop="@dimen/_24sdp"
                        app:layout_constraintTop_toBottomOf="@+id/cl_btn_layout"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:background="@drawable/common_btn_black_bg"
                        app:layout_constraintStart_toStartOf="@id/cl_btn_layout"
                        app:layout_constraintEnd_toEndOf="@id/cl_btn_layout"
                        app:layout_constraintTop_toBottomOf="@+id/tv_or">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/customBlackButton"
                            android:drawableStart="@drawable/ic_google"
                            android:drawablePadding="@dimen/_8sdp"
                            android:text="@string/sign_up_with_google"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </ScrollView>


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_dont_have_account"
                style="@style/customTextView"
                android:textColor="@color/secondaryTextColor"
                android:layout_marginBottom="@dimen/_30sdp"
                app:layout_constraintStart_toStartOf="@id/scroll_main"
                app:layout_constraintEnd_toEndOf="@id/scroll_main"
                android:text="@string/dont_have_account"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
