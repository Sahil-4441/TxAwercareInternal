<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:id="@+id/scroll_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/_24sdp"
            android:layout_marginVertical="@dimen/_16sdp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@+id/tv_dont_have_account"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/app_rounded_black_bg"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_25sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/img_logo"
                    android:layout_width="@dimen/_70sdp"
                    android:layout_height="@dimen/_70sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:src="@drawable/ic_logo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_main_heading"
                    style="@style/TvFontSemibold"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/welcome_back"
                    android:textSize="@dimen/_16ssp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/img_logo" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_sub_heading"
                    style="@style/customTextView"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:paddingHorizontal="@dimen/_45sdp"
                    android:text="@string/signing_to_your_account"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_main_heading" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_email"
                    style="@style/TvFontSemibold"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/email"
                    android:textColor="@color/secondaryTextColor"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_sub_heading" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_email"
                    style="@style/edt"
                    android:hint="@string/email"
                    android:inputType="textEmailAddress"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_email"
                    app:layout_constraintTop_toBottomOf="@+id/tv_email" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_password"
                    style="@style/TvFontSemibold"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/password"
                    android:textColor="@color/secondaryTextColor"
                    android:textSize="@dimen/_12ssp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/et_email" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/password_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="@string/password"
                    app:boxBackgroundMode="none"
                    app:endIconMode="password_toggle"
                    app:helperTextTextColor="@color/primaryEtTextColor"
                    app:hintEnabled="false"
                    app:hintTextColor="@color/primaryEtTextColor"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_password"
                    app:layout_constraintTop_toBottomOf="@+id/tv_password"
                    app:passwordToggleDrawable="@drawable/password_selector"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password"
                        style="@style/customTextInputEt"
                        android:fontFamily="@font/inter_medium"
                        android:hint="@string/password"
                        android:inputType="textPassword"
                        android:textSize="@dimen/_11ssp" />

                </com.google.android.material.textfield.TextInputLayout>


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_forgot_password"
                    style="@style/TvFontSemibold"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="@string/forgot_password"
                    android:textColor="@color/secondaryTextColor"
                    android:textSize="@dimen/_12ssp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/password_layout" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_btn_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:background="@drawable/common_btn_bg"
                    app:layout_constraintTop_toBottomOf="@+id/tv_forgot_password">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btn_submit"
                        style="@style/buttonWithArrow"
                        android:text="@string/log_in"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:id="@+id/view_sep_before"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginVertical="@dimen/_25sdp"
                    android:background="@color/midnight_blue"
                    app:layout_constraintEnd_toStartOf="@+id/tv_or"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cl_btn_layout" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_or"
                    style="@style/customTextView"
                    android:paddingHorizontal="@dimen/_15sdp"
                    android:text="@string/or"
                    android:textSize="@dimen/_9sdp"
                    app:layout_constraintBottom_toBottomOf="@+id/view_sep_before"
                    app:layout_constraintEnd_toStartOf="@+id/view_sep_after"
                    app:layout_constraintStart_toEndOf="@+id/view_sep_before"
                    app:layout_constraintTop_toTopOf="@id/view_sep_before" />

                <View
                    android:id="@+id/view_sep_after"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginVertical="@dimen/_25sdp"
                    android:background="@color/midnight_blue"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_or"
                    app:layout_constraintTop_toBottomOf="@+id/cl_btn_layout" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:background="@drawable/common_btn_black_bg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_or">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/customBlackButton"
                        android:drawableStart="@drawable/ic_google"
                        android:drawablePadding="@dimen/_8sdp"
                        android:text="@string/sign_up_with_google"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_dont_have_account"
            style="@style/customTextView"
            android:layout_marginBottom="@dimen/_16sdp"
            android:text="@string/dont_have_account"
            android:textColor="@color/secondaryTextColor"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>
