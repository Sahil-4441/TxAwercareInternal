<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginBottom="@dimen/_40sdp"
            app:cardElevation="@dimen/_4sdp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginHorizontal="@dimen/_16sdp"
            app:cardBackgroundColor="@color/dark_grey_color">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_12sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/img_logo"
                    android:layout_width="@dimen/_70sdp"
                    android:src="@drawable/ic_logo"
                    android:layout_height="@dimen/_70sdp"
                    android:layout_marginTop="@dimen/_16sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_main_heading"
                    style="@style/TvFontSemibold"
                    android:textSize="@dimen/_16ssp"
                    android:layout_marginTop="@dimen/_20sdp"
                    app:layout_constraintTop_toBottomOf="@+id/img_logo"
                    app:layout_constraintStart_toStartOf="@id/img_logo"
                    app:layout_constraintEnd_toEndOf="@id/img_logo"
                    android:text="@string/reset_your_password"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_sub_heading"
                    style="@style/customTextView"
                    android:layout_marginHorizontal="@dimen/_40sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_main_heading"
                    app:layout_constraintStart_toStartOf="@id/tv_main_heading"
                    app:layout_constraintEnd_toEndOf="@id/tv_main_heading"
                    android:text="@string/create_new_password"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_new_password"
                    style="@style/TvFontSemibold"
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/secondaryTextColor"
                    android:layout_marginTop="@dimen/_20sdp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_sub_heading"
                    app:layout_constraintStart_toStartOf="parent"
                    android:text="@string/new_password"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/password_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="password_toggle"
                    android:text="@string/password"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleDrawable="@drawable/password_selector"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:hintTextColor="@color/primaryEtTextColor"
                    app:helperTextTextColor="@color/primaryEtTextColor"
                    app:layout_constraintTop_toBottomOf="@+id/tv_new_password"
                    app:layout_constraintStart_toStartOf="@id/tv_new_password"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password"
                        style="@style/customTextInputEt"
                        android:hint="@string/password"
                        android:textSize="@dimen/_11ssp"
                        android:fontFamily="@font/inter_medium"
                        android:inputType="textPassword"/>

                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_confirm_password"
                    style="@style/TvFontSemibold"
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/secondaryTextColor"
                    android:layout_marginTop="@dimen/_12sdp"
                    app:layout_constraintTop_toBottomOf="@+id/password_layout"
                    app:layout_constraintStart_toStartOf="@id/password_layout"
                    android:text="@string/confirm_password"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/confirm_password_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="password_toggle"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleDrawable="@drawable/password_selector"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:hintTextColor="@color/primaryEtTextColor"
                    app:helperTextTextColor="@color/primaryEtTextColor"
                    app:layout_constraintTop_toBottomOf="@+id/tv_confirm_password"
                    app:layout_constraintStart_toStartOf="@id/tv_confirm_password"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_confirm_password"
                        style="@style/customTextInputEt"
                        android:hint="@string/confirm_password"
                        android:textSize="@dimen/_11ssp"
                        android:fontFamily="@font/inter_medium"
                        android:inputType="textPassword"/>
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_btn_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_30sdp"
                    android:background="@drawable/common_btn_bg"
                    app:layout_constraintEnd_toEndOf="@+id/confirm_password_layout"
                    app:layout_constraintStart_toStartOf="@+id/confirm_password_layout"
                    app:layout_constraintTop_toBottomOf="@+id/confirm_password_layout">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btn_submit"
                        style="@style/buttonWithArrow"
                        android:text="@string/submit"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
