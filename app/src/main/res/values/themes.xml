<resources>

  <style name="Theme.App" parent="Theme.MaterialComponents.Light.NoActionBar">
    <!-- Primary brand color. -->
    <item name="colorPrimary">@color/primaryColor</item>
    <item name="colorPrimaryVariant">@color/primaryColor</item>
    <item name="colorOnPrimary">@color/app_bg</item>
    <!-- Secondary brand color. -->
    <item name="colorSecondary">@color/primaryColor</item>
    <item name="colorSecondaryVariant">@color/primaryColor</item>
    <item name="colorOnSecondary">@color/black</item>
    <!-- Status bar color. -->
    <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    <item name="android:windowIsTranslucent">true</item>
    <item name="textInputStyle">@style/Widget.MyApp.TextInputLayout</item>
    <!-- Customize your theme here. -->
  </style>

  <style name="Theme.App.NoActionBar">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
  </style>

  <style name="Widget.MyApp.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
    <item name="boxBackgroundMode">outline</item>
    <item name="boxCornerRadiusTopStart">@dimen/_6sdp</item>
    <item name="boxCornerRadiusTopEnd">@dimen/_6sdp</item>
    <item name="boxCornerRadiusBottomStart">@dimen/_6sdp</item>
    <item name="boxCornerRadiusBottomEnd">@dimen/_6sdp</item>
    <item name="boxStrokeWidth">1dp</item>
    <item name="boxStrokeWidthFocused">1dp</item>
    <item name="boxStrokeColor">@color/common_edt_stroke_color</item>
    <item name="boxStrokeErrorColor">@color/red_light_color</item>
    <item name="boxBackgroundColor">@color/secondary_dark_grey</item>
    <item name="errorIconDrawable">@null</item>
    <item name="errorIconTint">@null</item>
    <item name="errorTextAppearance">@style/MyErrorTextStyle</item>
    <item name="errorTextColor">@color/red_light_color</item>
    <item name="hintEnabled">false</item>
  </style>



  <style name="FullScreenDialogTheme">
    <item name="android:windowFrame">@null</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowIsFloating">true</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowTitleStyle">@null</item>
    <item name="android:windowSoftInputMode">stateUnspecified|adjustPan</item>
    <item name="android:backgroundDimEnabled">true</item>
    <item name="android:background">@android:color/transparent</item>
  </style>

  <style name="buttonWithArrow">
    <item name="android:drawableEnd">@drawable/ic_arrow</item>
    <item name="android:drawablePadding">@dimen/_8sdp</item>
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:paddingTop">@dimen/_10sdp</item>
    <item name="android:paddingBottom">@dimen/_10sdp</item>
    <item name="android:gravity">center</item>
    <item name="android:fontFamily">@font/inter_semibold</item>
    <item name="android:textSize">@dimen/_13ssp</item>
    <item name="android:textColor">@color/black</item>
  </style>



  <style name="buttonWithOutArrow">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:paddingTop">@dimen/_10sdp</item>
    <item name="android:paddingBottom">@dimen/_10sdp</item>
    <item name="android:gravity">center</item>
    <item name="android:fontFamily">@font/inter_semibold</item>
    <item name="android:textSize">@dimen/_13ssp</item>
    <item name="android:textColor">@color/black</item>
  </style>

  <style name="customButton" parent="Widget.AppCompat.Button">
    <item name="android:drawable">@drawable/common_btn_bg</item>
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">center</item>
    <item name="android:paddingTop">@dimen/_8sdp</item>
    <item name="android:paddingBottom">@dimen/_8sdp</item>
    <item name="android:fontFamily">@font/inter_semibold</item>
    <item name="android:textSize">@dimen/_12ssp</item>
    <item name="android:textColor">@color/black</item>
  </style>

  <style name="customBlackButton" parent="Widget.AppCompat.TextView">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">center</item>
    <item name="android:fontFamily">@font/inter_semibold</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:paddingTop">@dimen/_10sdp</item>
    <item name="android:paddingBottom">@dimen/_10sdp</item>
    <item name="android:textSize">@dimen/_13ssp</item>
    <item name="android:textColor">@color/white</item>
  </style>

  <style name="customTextView" parent="Widget.AppCompat.TextView">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">center</item>
    <item name="android:textSize">@dimen/_11ssp</item>
    <item name="android:fontFamily">@font/inter_regular</item>
    <item name="android:textColor">@color/secondaryTextColor</item>
  </style>

  <style name="TvFontSemibold" parent="Widget.AppCompat.TextView">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">center</item>
    <item name="android:textSize">@dimen/_12ssp</item>
    <item name="android:fontFamily">@font/inter_semibold</item>
    <item name="android:textColor">@color/white</item>
  </style>

  <style name="TvFontBold" parent="Widget.AppCompat.TextView">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">center</item>
    <item name="android:textSize">@dimen/_12ssp</item>
    <item name="android:fontFamily">@font/inter_bold</item>
    <item name="android:textColor">@color/white</item>
  </style>

  <style name="edt" parent="Widget.AppCompat.EditText">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColor">@color/primaryEtTextColor</item>
    <item name="android:textColorHint">@color/primaryEtTextColor</item>
    <item name="android:background">@drawable/common_et_bg</item>
    <item name="android:paddingStart">@dimen/_10sdp</item>
    <item name="android:paddingEnd">@dimen/_10sdp</item>
    <item name="android:paddingTop">@dimen/_10sdp</item>
    <item name="android:textSize">@dimen/_11ssp</item>
    <item name="android:fontFamily">@font/inter_medium</item>
    <item name="android:paddingBottom">@dimen/_10sdp</item>
    <item name="android:singleLine">true</item>
  </style>

  <style name="TvFontRegular">
    <item name="android:fontFamily">@font/inter_regular</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:includeFontPadding">false</item>
  </style>

  <style name="TvFontMedium">
    <item name="android:fontFamily">@font/inter_medium</item>
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:textSize">@dimen/_11sdp</item>
  </style>

  <style name="customTextInputEt" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColor">@color/primaryEtTextColor</item>
    <item name="android:textColorHint">@color/primaryEtTextColor</item>
    <item name="android:background">@drawable/common_et_bg</item>
    <item name="android:paddingStart">@dimen/_10sdp</item>
    <item name="android:paddingEnd">@dimen/_10sdp</item>
    <item name="android:paddingTop">@dimen/_10sdp</item>
    <item name="android:textSize">@dimen/_11ssp</item>
    <item name="android:fontFamily">@font/inter_medium</item>
    <item name="android:paddingBottom">@dimen/_10sdp</item>
    <item name="android:singleLine">true</item>
  </style>

  <style name="MyErrorTextStyle" parent="TextAppearance.MaterialComponents.Caption">
    <item name="android:textColor">@color/red_light_color</item>
    <item name="android:textSize">@dimen/_10ssp</item>
    <item name="android:fontFamily">@font/inter_bold</item>
    <item name="android:paddingTop">0dp</item>
    <item name="android:layout_marginTop">0dp</item>
    <item name="android:layout_marginStart">0dp</item>
    <item name="android:paddingStart">0dp</item>
    <item name="android:paddingBottom">0dp</item>
    <item name="android:gravity">start</item>
    <item name="android:textAlignment">viewStart</item>
  </style>

</resources>