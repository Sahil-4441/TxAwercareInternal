<resources>

  <style name="Theme.App" parent="Theme.MaterialComponents.Light.NoActionBar">
    <!-- Primary brand color. -->
    <item name="colorPrimary">@color/primaryColor</item>
    <item name="colorPrimaryVariant">@color/primaryColor</item>
    <item name="colorOnPrimary">@color/white</item>
    <!-- Secondary brand color. -->
    <item name="colorSecondary">@color/primaryColor</item>
    <item name="colorSecondaryVariant">@color/primaryColor</item>
    <item name="colorOnSecondary">@color/black</item>
    <!-- Status bar color. -->
    <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    <item name="android:windowIsTranslucent">true</item>

    <!-- Customize your theme here. -->
  </style>

  <style name="Theme.App.NoActionBar">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
  </style>

  <style name="FullScreenDialogTheme">
    <item name="android:windowFrame">@null</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowIsFloating">true</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowTitleStyle">@null</item>
    <item name="android:windowSoftInputMode">stateUnspecified|adjustPan</item>
    <item name="android:backgroundDimEnabled">true</item>
    <item name="android:background">@android:color/transparent</item>
  </style>

  <style name="customButtonWithArrow" parent="Widget.AppCompat.TextView">
    <item name="android:drawableEnd">@drawable/ic_arrow</item>
    <item name="android:drawablePadding">@dimen/_8sdp</item>
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:paddingTop">@dimen/_8sdp</item>
    <item name="android:paddingBottom">@dimen/_8sdp</item>
    <item name="android:gravity">center</item>
    <item name="android:fontFamily">@font/inter_semibold</item>
    <item name="android:textSize">@dimen/_13ssp</item>
    <item name="android:textColor">@color/black</item>
  </style>

  <style name="customButton" parent="Widget.AppCompat.Button">
    <item name="android:drawable">@drawable/common__btn_bg</item>
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">center</item>
    <item name="android:paddingTop">@dimen/_8sdp</item>
    <item name="android:paddingBottom">@dimen/_8sdp</item>
    <item name="android:fontFamily">@font/inter_semibold</item>
    <item name="android:textSize">@dimen/_12ssp</item>
    <item name="android:textColor">@color/black</item>
  </style>

  <style name="customBlackButton" parent="Widget.AppCompat.TextView">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">center</item>
    <item name="android:fontFamily">@font/inter_semibold</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:paddingTop">@dimen/_8sdp</item>
    <item name="android:paddingBottom">@dimen/_8sdp</item>
    <item name="android:textSize">@dimen/_13ssp</item>
    <item name="android:textColor">@color/white</item>
  </style>

  <style name="customTextView" parent="Widget.AppCompat.TextView">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">center</item>
    <item name="android:textSize">@dimen/_11ssp</item>
    <item name="android:fontFamily">@font/inter_regular</item>
    <item name="android:textColor">@color/secondaryTextColor</item>
  </style>

  <style name="customTvSemiBold" parent="Widget.AppCompat.TextView">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">center</item>
    <item name="android:textSize">@dimen/_12ssp</item>
    <item name="android:fontFamily">@font/inter_semibold</item>
    <item name="android:textColor">@color/white</item>
  </style>

  <style name="customTvBold" parent="Widget.AppCompat.TextView">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">center</item>
    <item name="android:textSize">@dimen/_12ssp</item>
    <item name="android:fontFamily">@font/inter_bold</item>
    <item name="android:textColor">@color/white</item>
  </style>

  <style name="customEt" parent="Widget.AppCompat.EditText">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColor">@color/primaryEtTextColor</item>
    <item name="android:textColorHint">@color/primaryEtTextColor</item>
    <item name="android:background">@drawable/common_et_bg</item>
    <item name="android:layout_marginTop">@dimen/_5sdp</item>
    <item name="android:paddingStart">@dimen/_8sdp</item>
    <item name="android:paddingEnd">@dimen/_8sdp</item>
    <item name="android:paddingTop">@dimen/_8sdp</item>
    <item name="android:textSize">@dimen/_11ssp</item>
    <item name="android:fontFamily">@font/inter_medium</item>
    <item name="android:paddingBottom">@dimen/_8sdp</item>
    <item name="android:singleLine">true</item>
  </style>

  <style name="TextViewFontRegular">
    <item name="android:fontFamily">@font/inter_regular</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:textColor">@color/primaryEtTextColor</item>
  </style>

  <style name="customTextInputEt" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColor">@color/primaryEtTextColor</item>
    <item name="android:textColorHint">@color/primaryEtTextColor</item>
    <item name="android:background">@drawable/common_et_bg</item>
    <item name="android:layout_marginTop">@dimen/_5sdp</item>
    <item name="android:paddingStart">@dimen/_8sdp</item>
    <item name="android:paddingEnd">@dimen/_8sdp</item>
    <item name="android:paddingTop">@dimen/_8sdp</item>
    <item name="android:textSize">@dimen/_11ssp</item>
    <item name="android:fontFamily">@font/inter_medium</item>
    <item name="android:paddingBottom">@dimen/_8sdp</item>
    <item name="android:singleLine">true</item>
  </style>



</resources>