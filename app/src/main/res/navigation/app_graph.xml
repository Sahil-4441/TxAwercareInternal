<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.avercare.presentation.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_signup"
            app:destination="@id/signupFragment" />
        <action
            android:id="@+id/action_login_to_example"
            app:destination="@id/exampleFragment" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.avercare.presentation.auth.SignupFragment"
        android:label="Sign Up" />

    <fragment
        android:id="@+id/exampleFragment"
        android:name="com.example.avercare.presentation.example.ExampleFragment"
        android:label="Example"/>
</navigation>
