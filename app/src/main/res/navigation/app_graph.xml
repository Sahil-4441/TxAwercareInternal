<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/verificationFragment">

    <fragment
        android:id="@+id/onBoardingFragment"
        android:name="com.example.avercare.presentation.onboarding.OnBoardingFragment"
        android:label="OnBoardingFragment">
        <action
            android:id="@+id/action_onBoardingFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_onBoarding_to_signup"
            app:destination="@id/signupFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.avercare.presentation.login.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_signup"
            app:destination="@id/signupFragment" />

    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.avercare.presentation.signup.SignupFragment"
        android:label="Sign Up">
        <action
            android:id="@+id/action_signup_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/verificationFragment"
        android:name="com.example.avercare.presentation.verification.VerificationFragment"
        android:label="VerificationFragment">
        <action
            android:id="@+id/action_verificationFragment_to_verifyOtpFragment"
            app:destination="@id/verifyOtpFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

    <fragment
        android:id="@+id/verifyOtpFragment"
        android:name="com.example.avercare.presentation.verifyOtp.VerifyOtpFragment"
        android:label="VerifyOtpFragment" />

</navigation>
